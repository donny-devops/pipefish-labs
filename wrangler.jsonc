{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipefish-labs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "UPSTREAM_URL": "https://pipefishlabs.io"
  },
  "observability": {
    "enabled": true
  }
}
