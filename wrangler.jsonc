{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipefish-labs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
