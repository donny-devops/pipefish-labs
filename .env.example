# Copy to .env and replace placeholders. Never commit .env.

# Python SDK / agent mesh
PIPEFISH_API_KEY=placeholder_pipefish_api_key
PIPEFISH_ENV=development

# Cloudflare Workers (local wrangler / GitHub Actions deploy)
CLOUDFLARE_API_TOKEN=placeholder_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=placeholder_cloudflare_account_id

# npm publish
NPM_TOKEN=placeholder_npm_token

# Edge worker
ENVIRONMENT=development
WEBHOOK_SECRET=placeholder_webhook_secret
RESEND_API_KEY=placeholder_resend_api_key
PQC_HARDENING_ENABLED=active
