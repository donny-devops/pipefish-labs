{
  "info": {
    "_postman_id": "8fa812a0-4991-4d7a-a430-pipefish-mesh",
    "name": "PipeFish Labs Multi-Agent Mesh API Collection",
    "description": "Automated regression testing collection for PipeFish Labs OpenAPI 3.1 endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Service is healthy', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('healthy');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "List Available Agents",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 401 (Auth)', function () {",
              "    pm.expect([200, 401]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agents",
          "host": ["{{baseUrl}}"],
          "path": ["agents"]
        }
      }
    },
    {
      "name": "Execute System Optimizing Graph",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Graph execution response verified', function () {",
              "    pm.expect([200, 201, 202, 401]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payload\": {\n    \"alert\": \"High CPU utilization on ingress pod-491\"\n  },\n  \"handoff_mode\": \"mistral_native\",\n  \"zdr_enabled\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphs/systemoptimizing/execute",
          "host": ["{{baseUrl}}"],
          "path": ["graphs", "systemoptimizing", "execute"]
        }
      }
    }
  ]
}
